# ============================================================
# AI Test Knowledge Platform —— 环境变量模板
# 用法：cp .env.example .env 后按需填写
# ============================================================

# ---------------- 应用 ----------------
APP_NAME=AI Test Knowledge Platform
APP_ENV=local
DEBUG=true
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api/v1

# ---------------- PostgreSQL + pgvector ----------------
# 与 docker-compose.yml 中的服务保持一致
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ai_test_knowledge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ---------------- Embedding（OpenAI-compatible /v1/embeddings）----------------
# 默认使用本机 OMLX；远端兼容端点需替换地址与 Key
EMBEDDING_BASE_URL=http://127.0.0.1:28080/v1
EMBEDDING_API_KEY=omlx
EMBEDDING_MODEL=bge-m3-mlx-4bit
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT=60
EMBEDDING_MAX_RETRIES=2

# ---------------- Reranker（OpenAI-compatible /v1/rerank）----------------
RERANK_BASE_URL=http://127.0.0.1:28080/v1
RERANK_API_KEY=
RERANK_MODEL=Qwen3.5-9B-DFlash
# 预检会调用一次 /rerank；若服务端报模型加载失败，先换成可用模型
RERANK_TOP_N=5
RERANK_TIMEOUT=60
RERANK_MAX_RETRIES=2

# ---------------- LLM（OpenAI-compatible，双通道可切换）----------------
# LLM_PROVIDER 取值：ollama | openai_compatible
# 默认使用本机 OMLX；OMLX 同时承载 Embedding 与 Chat Completions
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://127.0.0.1:28080/v1
LLM_API_KEY=omlx
LLM_MODEL=Ling-3.0-tiny-oQ6e

# 也可切换为本地 Ollama 或云 API：
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:8b

LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
# 必须 <= RAG_REQUEST_TIMEOUT，否则「到点返回 503」之后底层调用还能继续占用资源
LLM_TIMEOUT=30

# ---------------- RAG 请求预算 ----------------
# RAG 请求的端到端预算（含 Embedding + 检索 + LLM），超过即返回 503；
# 实测本机 OMLX Ling-3.0-tiny-oQ6e 单次生成约 30 秒，故留 45 秒余量
RAG_REQUEST_TIMEOUT=45
# 同时执行的 RAG 推理任务上限；满载直接 429，不排队
RAG_MAX_CONCURRENCY=4

# ---------------- 检索参数 ----------------
RETRIEVAL_VECTOR_TOP_K=20
RETRIEVAL_KEYWORD_TOP_K=20
RETRIEVAL_FUSION=rrf
RETRIEVAL_RRF_K=60
RETRIEVAL_FINAL_TOP_K=5
