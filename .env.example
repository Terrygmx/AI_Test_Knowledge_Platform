# ============================================================
# AI Test Knowledge Platform —— 环境变量模板
# 用法：cp .env.example .env 后按需填写
# ============================================================

# ---------------- 应用 ----------------
APP_NAME=AI Test Knowledge Platform
APP_ENV=local
DEBUG=true
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api/v1

# ---------------- PostgreSQL + pgvector ----------------
# 与 docker-compose.yml 中的服务保持一致
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ai_test_knowledge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ---------------- Embedding（OpenAI-compatible /v1/embeddings）----------------
# 默认使用本机 OMLX；远端兼容端点需替换地址与 Key
EMBEDDING_BASE_URL=http://127.0.0.1:28080/v1
EMBEDDING_API_KEY=omlx
EMBEDDING_MODEL=bge-m3-mlx-4bit
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32

# ---------------- Reranker（OpenAI-compatible /v1/rerank）----------------
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_N=5

# ---------------- LLM（OpenAI-compatible，双通道可切换）----------------
# LLM_PROVIDER 取值：ollama | openai_compatible
# --- 通道 A：本地 Ollama（默认，注意需先 ollama pull 模型）---
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b
# --- 通道 B：云 API（取消注释并填写 Key 后覆盖上面的配置）---
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek-chat

LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120

# ---------------- 检索参数 ----------------
RETRIEVAL_VECTOR_TOP_K=20
RETRIEVAL_KEYWORD_TOP_K=20
RETRIEVAL_FUSION=rrf
RETRIEVAL_RRF_K=60
RETRIEVAL_FINAL_TOP_K=5
